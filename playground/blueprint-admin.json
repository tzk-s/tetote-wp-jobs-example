{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "TETOTE Jobs Example",
    "description": "架空の募集職種でプラグインを試すデモ。ブラウザー内だけで動き、変更は保存されません。",
    "author": "tzk-s"
  },
  "landingPage": "/wp-admin/edit.php?post_type=tetote_job",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "TETOTE Jobs Example（架空）",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/tzk-s/tetote-wp-jobs-example",
        "ref": "main",
        "refType": "branch",
        "path": "tetote-jobs"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require TETOTE_JOBS_DIR . 'demo/seed.php'; tetote_jobs_demo_seed(); tetote_jobs_demo_remove_defaults();"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/tetote-jobs-demo.php",
      "data": "<?php\n// デモ用: 管理画面の表示を絞る（tetote-jobs/demo/admin.php）\nif (file_exists(WP_PLUGIN_DIR . '/tetote-jobs/demo/admin.php')) {\n  require WP_PLUGIN_DIR . '/tetote-jobs/demo/admin.php';\n}\n"
    }
  ]
}
