# ローカル検証専用の設定例。本番や公開サーバーでは使わないでください。
# cp .env.example .env でコピーし、必要なら値を変えてください（.env は Git に入りません）。

# ブラウザーで開くポート番号（http://127.0.0.1:8088/）。他のアプリと重なるときに変える
WP_PORT=8088

# データベース（架空のローカル専用の値）
DB_NAME=tetote_jobs
DB_USER=tetote_jobs
DB_PASSWORD=local-only-db-password
DB_ROOT_PASSWORD=local-only-root-password

# WordPress の管理者（初期設定のときに作る。架空のローカル専用の値）
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=local-only-admin-password
WP_ADMIN_EMAIL=admin@example.com
